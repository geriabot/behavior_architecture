# Source dependencies of the LLM orchestrators (orchestrator types llm, mcp and llm_bt) and of
# llm_plan_executor, llm_bt_executor and start_mission. Without them behavior_architecture builds
# its base only. Import them next to behavior_architecture:
#   vcs import <ws>/src < behavior_architecture/llm.repos
repositories:
  llm_bt_builder:
    type: git
    url: https://github.com/rodperex/llm_bt_builder.git
    version: main
  llm_planner:
    type: git
    url: https://github.com/rodperex/llm_planner.git
    version: main
