# Interpretation, opt-in (docs/INTERPRETATION_DESIGN.md, section 12).
#
# Defines the imported targets of interpretation without adding them to the package's default
# variables: behavior_architecture_TARGETS, _LIBRARIES, _INCLUDE_DIRS and _DEPENDENCIES hold
# only the base library, so a package that does not use interpretation does not link it.
# A package that uses it links one of:
#   behavior_architecture::interpretation
#     InterpretationClient, with the generated C++ interface and its dependencies
#   ${behavior_architecture_INTERPRETATION_TARGETS}
#     the same, as a list
#   ${behavior_architecture_INTERPRETATION_INTERFACE_TARGETS}
#     only the generated interface (behavior_architecture/srv/interpret.hpp)
# behavior_architecture_INTERPRETATION_FOUND is FALSE when a dependency of those targets is
# missing (interpretation_dependencies-extras.cmake). The BT nodes
# (libbehavior_architecture_interpretation_bt_nodes.so) are loaded by name in plugin_libraries
# and are not linked.
#
# This file is included before the package's other config files: rosidl's expect these targets
# to be defined. It finds nothing, so that the default variables are computed as without
# interpretation; the dependencies of the targets are found after them.

set(_behavior_architecture_interpretation_exports "@_interpretation_export_sets@")

set(behavior_architecture_INTERPRETATION_TARGETS "")
set(behavior_architecture_INTERPRETATION_INTERFACE_TARGETS "")
foreach(_export ${_behavior_architecture_interpretation_exports})
  set(_export_file "${behavior_architecture_DIR}/${_export}Export.cmake")
  include("${_export_file}")
  # the target names associated with the export, as ament_cmake_export_targets extracts them
  set(_regex "foreach\\((_cmake)?_expected_?[Tt]arget (IN ITEMS )?(.+)\\)")
  file(STRINGS "${_export_file}" _foreach_targets REGEX "${_regex}")
  list(LENGTH _foreach_targets _matches)
  if(NOT _matches EQUAL 1)
    message(FATAL_ERROR "Failed to find exported target names in '${_export_file}'")
  endif()
  string(REGEX REPLACE "${_regex}" "\\3" _targets "${_foreach_targets}")
  string(REPLACE " " ";" _targets "${_targets}")
  if(_targets STREQUAL "behavior_architecture::interpretation")
    list(APPEND behavior_architecture_INTERPRETATION_TARGETS ${_targets})
  else()
    list(APPEND behavior_architecture_INTERPRETATION_INTERFACE_TARGETS ${_targets})
  endif()
endforeach()

unset(_behavior_architecture_interpretation_exports)
unset(_export_file)
unset(_foreach_targets)
unset(_matches)
unset(_targets)
unset(_regex)
